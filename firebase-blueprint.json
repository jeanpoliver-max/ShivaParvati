{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Client data from lead capture",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "latitude": { "type": "number", "nullable": true },
        "longitude": { "type": "number", "nullable": true },
        "city": { "type": "string" }
      },
      "required": ["name", "phone", "date"]
    },
    "Reseller": {
      "title": "Reseller",
      "description": "Reseller data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "stateName": { "type": "string" },
        "city": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "googleMapsLink": { "type": "string" }
      },
      "required": ["name", "state", "city", "phone", "address", "googleMapsLink"]
    },
    "Product": {
      "title": "Product",
      "description": "Product data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" },
        "categoryId": { "type": "string" }
      },
      "required": ["name", "image", "categoryId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product Category data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name", "image"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Admin User",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["email", "password", "name"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Stores client lead captures"
    },
    "/resellers/{resellerId}": {
      "schema": { "$ref": "#/entities/Reseller" },
      "description": "Stores stores/resellers"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores products"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Stores product categories"
    },
    "/adminUsers/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Stores admin users"
    }
  }
}
