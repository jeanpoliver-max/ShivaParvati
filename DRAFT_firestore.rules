rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allow specific admin emails or just checking if they exist in a whitelist.
      // E.g. request.auth.token.email in ['jeanp.oliver@gmail.com']
      return isSignedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function isInitialAdmin() {
      return isSignedIn() && request.auth.token.email == 'jeanp.oliver@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /clients/{clientId} {
      // Anyone can create a lead, but to specify fields:
      allow create: if isValidId(clientId) && 
                       incoming().keys().hasAll(['name', 'phone', 'date']) &&
                       incoming().name is string && incoming().name.size() <= 100 &&
                       incoming().phone is string && incoming().phone.size() <= 20 &&
                       incoming().date is string && incoming().date.size() <= 100;
      allow read, update, delete: if isAdmin() || isInitialAdmin();
      allow list: if isAdmin() || isInitialAdmin();
    }

    match /resellers/{resellerId} {
      allow read, list: if true; // Public list
      allow create, update, delete: if isAdmin() || isInitialAdmin();
    }

    match /products/{productId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin() || isInitialAdmin();
    }

    match /categories/{categoryId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin() || isInitialAdmin();
    }

    match /adminUsers/{adminId} {
      // the initial admin can read/write admins, other admins can as well
      allow read, list: if isAdmin() || isInitialAdmin();
      allow create, update, delete: if isAdmin() || isInitialAdmin();
    }

  }
}
